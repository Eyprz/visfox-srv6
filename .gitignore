# ==========================================
# VISFOX-SRv6 .gitignore
# ==========================================

# ------------------------------------------
# Operating System & IDE / Editors
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# JetBrains (GoLand, WebStorm, IntelliJ, etc.)
.idea/
*.iws
*.iml
*.ipr
out/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Other Editors (Vim, Emacs, etc.)
*.swp
*.swo
*~
.#*
\#*#

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.crt

# ------------------------------------------
# Backend (Go)
# ------------------------------------------
# Binaries & Compiled Files
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Test binaries & Coverage / Profile reports
*.test
*.out
cover.out
coverage.txt
coverage.html
profile.pprof

# Live reload (e.g. Air)
tmp/
.air/

# Go Modules / Vendor
# (Uncomment if you do not want to track vendor directory)
# vendor/

# ------------------------------------------
# Frontend (React / Node.js)
# ------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Build Outputs (Vite, Next.js, CRA, etc.)
build/
dist/
out/
.next/
storybook-static/

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache & Temporary Files
.cache/
.parcel-cache
.eslintcache
.stylelintcache
*.tsbuildinfo
.turbo

# ------------------------------------------
# Infrastructure & Containers (Docker / Docker Compose)
# ------------------------------------------
# Local Docker Compose overrides
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml
docker-compose.local.yml
docker-compose.local.yaml

# Local data volumes & database persistent mounts
/data/
/.data/
/volumes/

# ------------------------------------------
# General Logs & Reports
# ------------------------------------------
logs/
*.log

# IEL build output (air)
iel/tmp/
iel/data/
