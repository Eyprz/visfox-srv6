# VISFOX-SRv6 gateway: serves the WebUI and the IEL API on a single port.
#
#   /api/v1/events  -> IEL (Server-Sent Events, unbuffered)
#   /api/           -> IEL (REST)
#   /               -> WebUI (Vite dev server incl. HMR WebSocket)
#
# SPA routes must never start with /api/, /assets/, /@, /src/, /node_modules/ or /mockServiceWorker.js.
#
# Upstreams are resolved per request through Docker's DNS so nginx starts even when the IEL is not running
# (requests to /api/ then return 502; the in-browser MSW mock handles /api/ before it reaches nginx).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $visfox_webapp ${VISFOX_WEBAPP_UPSTREAM};
    set $visfox_api ${VISFOX_API_UPSTREAM};

    client_max_body_size 1m;

    # --- IEL: Server-Sent Events -------------------------------------------------
    location = /api/v1/events {
        proxy_pass $visfox_api;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        chunked_transfer_encoding off;
    }

    # --- IEL: REST ----------------------------------------------------------------
    location /api/ {
        proxy_pass $visfox_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # --- WebUI (dev: Vite with HMR WebSocket) ---------------------------------------
    # Host is rewritten to localhost because Vite rejects unknown host names.
    # For a production build, replace this block with a static root and `try_files $uri /index.html;`.
    location / {
        proxy_pass $visfox_webapp;
        proxy_http_version 1.1;
        proxy_set_header Host localhost;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
    }
}
